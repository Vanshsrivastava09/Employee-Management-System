# Employee Management System - Environment Variables Example
# Copy this file to .env and fill in the actual values for your environment

# =========================
# Database Configuration (Production)
# =========================
MYSQL_URL=jdbc:mysql://localhost:3306/employee_ms?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here

# =========================
# Admin Credentials
# =========================
# IMPORTANT: Change these from default values in production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password_in_production
ADMIN_EMAIL=admin@yourcompany.com

# =========================
# SMTP Configuration (for password reset emails)
# =========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@yourcompany.com

# =========================
# Frontend URL (for password reset links)
# =========================
FRONTEND_URL=https://your-frontend-domain.com

# =========================
# CORS Configuration
# =========================
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# =========================
# Session Configuration
# =========================
SESSION_TIMEOUT=30m

# =========================
# Server Configuration
# =========================
SERVER_PORT=8080
